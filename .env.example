# ZOI FINANCE AI — contoh konfigurasi.
# Salin ke .env lalu isi. JANGAN commit file .env.
#   cp .env.example .env
#
# Di Lunafy, nilai-nilai ini diisi di tab Variables pada panel, BUKAN dengan
# mengunggah file .env.

# ─── Telegram ───────────────────────────────────────────────
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram ID numerik administrator (bukan username).
# Cari ID Anda dengan mengirim pesan ke @userinfobot
ADMIN_TELEGRAM_ID=

# ─── Database: Supabase PostgreSQL ──────────────────────────
# PAKAI "Pooler session mode" (port 5432). Ambil dari dashboard Supabase:
#   Connect → Session pooler
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Kenapa session mode, bukan yang lain:
#   • Direct connection (db.<ref>.supabase.co) pada paket Free hanya IPv6.
#   • Transaction mode (port 6543) tidak mendukung prepared statements, yang
#     dipakai asyncpg secara default.
#   • Session mode adalah IPv4 dan memang untuk backend berproses panjang.
#
# Parameter ?sslmode=require aman ditempel apa adanya — app/config.py
# menormalisasinya menjadi ssl=require untuk asyncpg.
#
# Lokal tanpa PostgreSQL (hanya untuk mencoba bot, bukan untuk data nyata):
#   sqlite+aiosqlite:///./zoi_local.db
DATABASE_URL=

# ─── AI: utama OpenRouter (HANYA model gratis) ──────────────
OPENROUTER_API_KEY=
# Daftar dipisah koma, dicoba berurutan.
# SETIAP nama WAJIB berakhiran ":free" — kalau tidak, bot menolak start.
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-2-9b-it:free

# ─── AI: cadangan Gemini (free tier) ────────────────────────
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

# ─── Lokal ──────────────────────────────────────────────────
TIMEZONE=Asia/Jakarta
CURRENCY=IDR

# ─── Batas & ketahanan ──────────────────────────────────────
MAX_TRANSACTION_AMOUNT=999999999
PENDING_EXPIRE_MINUTES=10
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO

# Pool koneksi kecil: Lunafy memberi 256 MB RAM untuk seluruh proses.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Menyentuh database tiap N jam agar proyek Supabase Free tidak dijeda
# otomatis karena aktivitas rendah selama 7 hari. 0 = matikan.
KEEPALIVE_HOURS=6
